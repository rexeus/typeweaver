{
  "name": "typeweaver-todo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "typeweaver generate --config ./{{configFile}}",
    "validate": "typeweaver validate --config ./{{configFile}}",
    "doctor": "typeweaver doctor --config ./{{configFile}} --deep",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rexeus/typeweaver-core": "^{{typeweaverVersion}}",
    "zod": "{{zodVersion}}"
  },
  "devDependencies": {
    "@rexeus/typeweaver": "^{{typeweaverVersion}}",
    "typescript": "^6.0.2"
  }
}
