import { defineResponse, HttpStatusCode } from "@rexeus/typeweaver-core";
import { z } from "zod";

export const ConflictError = defineResponse({
  name: "ConflictError",
  description: "The request conflicts with current state.",
  statusCode: HttpStatusCode.CONFLICT,
  body: z.object({
    code: z.literal("CONFLICT"),
    message: z.literal("The request conflicts with current state."),
  }),
});
