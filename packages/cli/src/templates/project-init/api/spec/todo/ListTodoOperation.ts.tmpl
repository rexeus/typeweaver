import {
  defineOperation,
  defineResponse,
  HttpMethod,
  HttpStatusCode,
} from "@rexeus/typeweaver-core";
import { z } from "zod";
import {
  ForbiddenError,
  InternalServerError,
  UnauthorizedError,
  ValidationError,
} from "../shared/errors/index.js";
import { listTodoQuerySchema, todoSchema } from "./schemas.js";

export const ListTodoOperation = defineOperation({
  operationId: "listTodos",
  summary: "List todos",
  method: HttpMethod.GET,
  path: "/todos",
  request: {
    query: listTodoQuerySchema,
  },
  responses: [
    defineResponse({
      name: "ListTodoSuccess",
      description: "Todos were listed.",
      statusCode: HttpStatusCode.OK,
      body: z.array(todoSchema),
    }),
    ValidationError,
    UnauthorizedError,
    ForbiddenError,
    InternalServerError,
  ],
});
