import {
  PluginConfigError,
  PluginExecutionError,
  definePlugin,
} from "@rexeus/typeweaver-gen";
import type {
  PluginConfig,
  PluginFactory,
} from "@rexeus/typeweaver-gen";
import { Effect } from "effect";

type {{pluginTypeName}}PluginOptions = {
  readonly message: string;
};

const parseOptions = (
  options: PluginConfig | undefined
): {{pluginTypeName}}PluginOptions => {
  const message = options?.message;
  if (message !== undefined && typeof message !== "string") {
    throw new PluginConfigError({
      pluginName: "{{pluginName}}-configurable",
      reason: "message must be a string when provided",
    });
  }
  return { message: message ?? "generated by the configurable factory" };
};

export const create{{pluginTypeName}}Plugin: PluginFactory = options => {
  const parsed = parseOptions(options);
  return definePlugin({
    name: "{{pluginName}}-configurable",
    generate: context =>
      context
        .writeFileEffect(
          "{{pluginName}}/configured.txt",
          `${parsed.message}\n`
        )
        .pipe(
          Effect.mapError(
            cause =>
              new PluginExecutionError({
                pluginName: "{{pluginName}}-configurable",
                phase: "generate",
                cause,
              })
          )
        ),
  });
};
