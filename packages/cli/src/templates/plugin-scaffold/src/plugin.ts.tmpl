import {
  PluginExecutionError,
  definePlugin,
} from "@rexeus/typeweaver-gen";
import type { Plugin } from "@rexeus/typeweaver-gen";
import { Effect } from "effect";

export const {{pluginIdentifier}}Plugin: Plugin = definePlugin({
  name: "{{pluginName}}",
  generate: context =>
    context
      .writeFileEffect(
        "{{pluginName}}/generated.txt",
        "generated by {{pluginName}}\n"
      )
      .pipe(
        Effect.mapError(
          cause =>
            new PluginExecutionError({
              pluginName: "{{pluginName}}",
              phase: "generate",
              cause,
            })
        )
      ),
});
