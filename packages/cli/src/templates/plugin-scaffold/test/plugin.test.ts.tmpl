import {
  createPluginTestKit,
  defineScopedPlugin,
} from "@rexeus/typeweaver-gen";
import type { NormalizedSpec } from "@rexeus/typeweaver-gen";
import { Context, Effect, Layer } from "effect";
import { describe, expect, test } from "vitest";
import {
  create{{pluginTypeName}}Plugin,
  {{pluginIdentifier}}Plugin,
} from "../src/index.js";

const normalizedSpec: NormalizedSpec = {
  metadata: { title: "{{pluginTypeName}} Plugin Test API", version: "1.0.0" },
  securitySchemes: [],
  security: { requirements: [], source: "none" },
  resources: [],
  responses: [],
  warnings: [],
};

describe("{{pluginName}} plugin", () => {
  test("generates through the public in-memory lifecycle kit", () => {
    const kit = createPluginTestKit({ normalizedSpec });
    const result = Effect.runSync(kit.run({{pluginIdentifier}}Plugin));

    expect(result.issues).toEqual([]);
    expect(result.files).toEqual([
      {
        path: "{{pluginName}}/generated.txt",
        content: "generated by {{pluginName}}\n",
      },
    ]);
  });

  test("supports the configurable factory contract", () => {
    const kit = createPluginTestKit({ normalizedSpec });
    const plugin = create{{pluginTypeName}}Plugin({ message: "configured" });
    const result = Effect.runSync(kit.run(plugin));

    expect(result.files).toEqual([
      {
        path: "{{pluginName}}/configured.txt",
        content: "configured\n",
      },
    ]);
  });
});

type TestProbe = {
  readonly value: string;
};

const TestProbe = Context.GenericTag<TestProbe>(
  "{{packageName}}/test/TestProbe"
);

test("provides test Layers without CLI internals", () => {
  const events: string[] = [];
  const layer = Layer.scoped(
    TestProbe,
    Effect.acquireRelease(
      Effect.sync(() => {
        events.push("acquire");
        return { value: "scoped" };
      }),
      () =>
        Effect.sync(() => {
          events.push("release");
        })
    )
  );
  const plugin = defineScopedPlugin({
    name: "{{pluginName}}-scoped-test",
    layer,
    generate: context =>
      Effect.flatMap(TestProbe, probe =>
        context.writeFileEffect("{{pluginName}}/scoped.txt", probe.value)
      ),
  });
  const kit = createPluginTestKit({ normalizedSpec });

  const result = Effect.runSync(kit.run(plugin));

  expect(result.files).toEqual([
    { path: "{{pluginName}}/scoped.txt", content: "scoped" },
  ]);
  expect(events).toEqual(["acquire", "release"]);
});
