--- README.md
# typeweaver-plugin-audit-log

TypeWeaver generator plugin scaffold for \`audit-log\`.

## Start

\`\`\`sh
pnpm install
pnpm check
\`\`\`

\`pnpm check\` typechecks the package, runs public in-memory lifecycle tests, builds the plugin, and
generates against the included integration spec.

## Public plugin shapes

- \`src/plugin.ts\` is the minimal record-style plugin and the package default export.
- \`src/configurablePlugin.ts\` is a synchronous configurable \`PluginFactory\`.
- \`test/plugin.test.ts\` uses \`createPluginTestKit\`, \`defineScopedPlugin\`, and a test Layer without
  private CLI services.

Plugins return Effects from \`validate\`, \`initialize\`, \`collectResources\`, \`generate\`, and
\`finalize\`. Contract diagnostics belong in the write-incapable \`validate\` phase as stable \`Issue\`
records. Expected lifecycle failures use \`PluginExecutionError\`; invalid factory options use
\`PluginConfigError\`.

## Effect contract

This scaffold develops against Effect 3.22.0 and declares the supported peer range
\`>=3.22.0 <4\`. Do not create a runtime inside plugin hooks. Use \`defineScopedPlugin\` when the plugin
owns an exit-independent Layer that must be acquired once and released after success, typed failure,
defect, or interruption.

## Install in a TypeWeaver project

Build the package, then reference its package name or local path in \`typeweaver.config.mjs\`:

\`\`\`js
export default {
  input: "./spec/index.ts",
  output: "./generated",
  plugins: ["typeweaver-plugin-audit-log"],
};
\`\`\`

--- src/configurablePlugin.ts
import {
  PluginConfigError,
  PluginExecutionError,
  definePlugin,
} from "@rexeus/typeweaver-gen";
import type {
  PluginConfig,
  PluginFactory,
} from "@rexeus/typeweaver-gen";
import { Effect } from "effect";

type AuditLogPluginOptions = {
  readonly message: string;
};

const parseOptions = (
  options: PluginConfig | undefined
): AuditLogPluginOptions => {
  const message = options?.message;
  if (message !== undefined && typeof message !== "string") {
    throw new PluginConfigError({
      pluginName: "audit-log-configurable",
      reason: "message must be a string when provided",
    });
  }
  return { message: message ?? "generated by the configurable factory" };
};

export const createAuditLogPlugin: PluginFactory = options => {
  const parsed = parseOptions(options);
  return definePlugin({
    name: "audit-log-configurable",
    generate: context =>
      context
        .writeFileEffect(
          "audit-log/configured.txt",
          \`\${parsed.message}\\n\`
        )
        .pipe(
          Effect.mapError(
            cause =>
              new PluginExecutionError({
                pluginName: "audit-log-configurable",
                phase: "generate",
                cause,
              })
          )
        ),
  });
};

--- src/index.ts
export {
  createAuditLogPlugin,
} from "./configurablePlugin.js";
export { auditLogPlugin } from "./plugin.js";
export { auditLogPlugin as default } from "./plugin.js";

--- src/plugin.ts
import {
  PluginExecutionError,
  definePlugin,
} from "@rexeus/typeweaver-gen";
import type { Plugin } from "@rexeus/typeweaver-gen";
import { Effect } from "effect";

export const auditLogPlugin: Plugin = definePlugin({
  name: "audit-log",
  generate: context =>
    context
      .writeFileEffect(
        "audit-log/generated.txt",
        "generated by audit-log\\n"
      )
      .pipe(
        Effect.mapError(
          cause =>
            new PluginExecutionError({
              pluginName: "audit-log",
              phase: "generate",
              cause,
            })
        )
      ),
});

--- test/fixture/spec.ts
import {
  HttpMethod,
  HttpStatusCode,
  defineOperation,
  defineResponse,
  defineSpec,
} from "@rexeus/typeweaver-core";

const ok = defineResponse({
  name: "ScaffoldOk",
  statusCode: HttpStatusCode.OK,
  description: "Scaffold integration response",
});

export const spec = defineSpec({
  metadata: { title: "AuditLog Scaffold API", version: "1.0.0" },
  resources: {
    scaffold: {
      operations: [
        defineOperation({
          operationId: "verifyScaffold",
          method: HttpMethod.GET,
          path: "/scaffold",
          summary: "Verify the scaffold",
          request: {},
          responses: [ok],
        }),
      ],
    },
  },
});

--- test/plugin.test.ts
import {
  createPluginTestKit,
  defineScopedPlugin,
} from "@rexeus/typeweaver-gen";
import type { NormalizedSpec } from "@rexeus/typeweaver-gen";
import { Context, Effect, Layer } from "effect";
import { describe, expect, test } from "vitest";
import {
  createAuditLogPlugin,
  auditLogPlugin,
} from "../src/index.js";

const normalizedSpec: NormalizedSpec = {
  metadata: { title: "AuditLog Plugin Test API", version: "1.0.0" },
  securitySchemes: [],
  security: { requirements: [], source: "none" },
  resources: [],
  responses: [],
  warnings: [],
};

describe("audit-log plugin", () => {
  test("generates through the public in-memory lifecycle kit", () => {
    const kit = createPluginTestKit({ normalizedSpec });
    const result = Effect.runSync(kit.run(auditLogPlugin));

    expect(result.issues).toEqual([]);
    expect(result.files).toEqual([
      {
        path: "audit-log/generated.txt",
        content: "generated by audit-log\\n",
      },
    ]);
  });

  test("supports the configurable factory contract", () => {
    const kit = createPluginTestKit({ normalizedSpec });
    const plugin = createAuditLogPlugin({ message: "configured" });
    const result = Effect.runSync(kit.run(plugin));

    expect(result.files).toEqual([
      {
        path: "audit-log/configured.txt",
        content: "configured\\n",
      },
    ]);
  });
});

type TestProbe = {
  readonly value: string;
};

const TestProbe = Context.GenericTag<TestProbe>(
  "typeweaver-plugin-audit-log/test/TestProbe"
);

test("provides test Layers without CLI internals", () => {
  const events: string[] = [];
  const layer = Layer.scoped(
    TestProbe,
    Effect.acquireRelease(
      Effect.sync(() => {
        events.push("acquire");
        return { value: "scoped" };
      }),
      () =>
        Effect.sync(() => {
          events.push("release");
        })
    )
  );
  const plugin = defineScopedPlugin({
    name: "audit-log-scoped-test",
    layer,
    generate: context =>
      Effect.flatMap(TestProbe, probe =>
        context.writeFileEffect("audit-log/scoped.txt", probe.value)
      ),
  });
  const kit = createPluginTestKit({ normalizedSpec });

  const result = Effect.runSync(kit.run(plugin));

  expect(result.files).toEqual([
    { path: "audit-log/scoped.txt", content: "scoped" },
  ]);
  expect(events).toEqual(["acquire", "release"]);
});

