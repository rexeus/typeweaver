{
  "name": "@rexeus/typeweaver-gen",
  "version": "0.12.0",
  "description": "Template-driven engine that turns structured API definitions into production-ready artifacts. Powered by Typeweaver 🧵✨",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "oxfmt",
    "test": "vitest run",
    "test:windows-security": "vitest run __test__/services/PathSafety.test.ts __test__/services/PathSafety.property.test.ts __test__/services/internal/pluginContextBuilder/context-metadata-and-output-paths.test.ts __test__/services/internal/pluginContextEffectIO.test.ts",
    "build": "tsdown",
    "prepack": "npm run build",
    "preversion": "npm run build"
  },
  "keywords": [
    "api",
    "spec",
    "definition",
    "typescript",
    "zod",
    "generator",
    "typeweaver"
  ],
  "author": "Dennis Wentzien <dw@rexeus.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexeus/typeweaver.git",
    "directory": "packages/gen"
  },
  "bugs": {
    "url": "https://github.com/rexeus/typeweaver/issues"
  },
  "homepage": "https://github.com/rexeus/typeweaver#readme",
  "peerDependencies": {
    "@rexeus/typeweaver-core": "workspace:^",
    "effect": "catalog:peers",
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@rexeus/typeweaver-core": "workspace:^",
    "effect": "4.0.0-rc.116",
    "fast-check": "^4.9.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "polycase": "^1.1.0"
  }
}
