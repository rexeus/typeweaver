{
  "name": "typeweaver",
  "private": true,
  "description": "Type-safe API framework with code generation for TypeScript",
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "typecheck": "turbo typecheck",
    "build": "turbo build && pnpm size",
    "size": "size-limit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix && pnpm format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo test:gen && turbo test",
    "test:gen": "turbo test:gen",
    "verify:generated": "node scripts/verify-generated.mjs",
    "publish:dry": "pnpm publish -r --dry-run --no-git-checks",
    "ci:publish": "pnpm publish -r --provenance",
    "prepare:commit": "pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "keywords": [
    "api",
    "spec",
    "definition",
    "typescript",
    "zod",
    "generator",
    "typeweaver"
  ],
  "author": "Dennis Wentzien <dw@rexeus.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexeus/typeweaver.git"
  },
  "bugs": {
    "url": "https://github.com/rexeus/typeweaver/issues"
  },
  "homepage": "https://github.com/rexeus/typeweaver#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@faker-js/faker": "^10.5.0",
    "@size-limit/file": "^13.0.1",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "size-limit": "^13.0.1",
    "tsdown": "0.22.14",
    "turbo": "^2.10.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "catalog:peers"
  }
}
