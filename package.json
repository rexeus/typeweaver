{
  "name": "typeweaver",
  "private": true,
  "description": "Type-safe API framework with code generation for TypeScript",
  "scripts": {
    "prepare": "node scripts/prepare-effect-reference.mjs",
    "typecheck": "turbo typecheck",
    "build": "turbo build && pnpm size",
    "size": "size-limit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix && pnpm format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo test:gen && turbo test",
    "test:windows-security": "pnpm -r --workspace-concurrency=1 --filter @rexeus/typeweaver-gen --filter @rexeus/typeweaver test:windows-security",
    "test:gen": "turbo test:gen",
    "test:maintainability-lint": "node scripts/test-maintainability-lint.mjs",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:effect-reference": "node scripts/verify-effect-reference.mjs && node scripts/test-effect-reference-guard.mjs",
    "effect:diagnostics": "node scripts/test-effect-diagnostics.mjs && node scripts/run-effect-diagnostics.mjs",
    "verify:effect-version": "node scripts/test-effect-version-contract.mjs && node scripts/check-effect-version-contract.mjs",
    "verify:release-version": "node scripts/test-release-version-contract.mjs && node scripts/check-release-version-contract.mjs",
    "verify:docs-examples": "node scripts/test-documentation-examples.mjs && node scripts/verify-documentation-examples.mjs && pnpm verify:docs-workflows",
    "verify:docs-workflows": "pnpm --filter @rexeus/typeweaver build && pnpm --filter @rexeus/typeweaver exec vitest --run --no-file-parallelism __test__/pluginScaffold.process.test.ts __test__/init.process.test.ts __test__/validate.process.test.ts __test__/doctor.process.test.ts",
    "docs:check": "node scripts/check-repository-truth.mjs && node scripts/check-vision-contract.mjs && pnpm verify:docs-examples && node scripts/check-markdown-links.mjs",
    "verify:packed-consumers": "node scripts/test-packed-consumers.mjs",
    "test:pnpm-launcher": "node scripts/test-pnpm-launcher.mjs",
    "verify:architecture-contracts": "node scripts/verify-architecture-contracts.mjs",
    "publish:dry": "pnpm publish -r --dry-run --no-git-checks",
    "ci:publish": "pnpm publish -r --provenance",
    "prepare:commit": "pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "keywords": [
    "api",
    "spec",
    "definition",
    "typescript",
    "zod",
    "generator",
    "typeweaver"
  ],
  "author": "Dennis Wentzien <dw@rexeus.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexeus/typeweaver.git"
  },
  "bugs": {
    "url": "https://github.com/rexeus/typeweaver/issues"
  },
  "homepage": "https://github.com/rexeus/typeweaver#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@effect/language-service": "0.87.1",
    "@faker-js/faker": "^10.5.0",
    "@size-limit/file": "^13.0.1",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint-plugin-sonarjs": "4.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "1.75.0",
    "size-limit": "^13.0.1",
    "tsdown": "0.22.14",
    "turbo": "^2.10.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "catalog:peers"
  }
}
